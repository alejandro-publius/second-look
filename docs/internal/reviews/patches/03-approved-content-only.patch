+def _unstamped(value: Any) -> Any:
+    if isinstance(value, Mapping):
+        return {k: _unstamped(v) for k, v in value.items() if k not in STAMP_KEYS}
+    if isinstance(value, list):
+        return [_unstamped(v) for v in value]
+    return value
