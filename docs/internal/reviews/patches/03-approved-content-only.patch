+
+def _filled(value: Any) -> bool:
+    return value is not None and bool(str(value).strip())
+
+
+def stamped(entry: Mapping[str, Any]) -> bool:
+    """approved: true with a name and a date beside it. A bare true is not an approval: anyone,
+    or any model, can type one, so it counts only when it says who and when."""
+    return (
+        entry.get("approved") is True
+        and _filled(entry.get("approved_by"))
+        and (_filled(entry.get("approved_on")) or _filled(entry.get("approved_at")))
+    )
+
