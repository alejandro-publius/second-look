+def _root_with_sentence(tmp_path: Path, **fields: Any) -> tuple[Path, dict[str, Any]]:
+    """A copy of content/ whose first sentence carries the given fields."""
+    root = tmp_path / "repo"
+    shutil.copytree(REPO / "content", root / "content")
+    path = root / "content" / "approved_sentences.yaml"
+    doc = yaml.safe_load(path.read_text(encoding="utf-8"))
+    for key in ("approved_by", "approved_on"):
+        doc["sentences"][0].pop(key, None)
+    doc["sentences"][0].update(fields)
+    path.write_text(yaml.safe_dump(doc), encoding="utf-8")
+    return root, doc["sentences"][0]
+
+
+def test_approve_writes_one_row_for_the_words_and_refuses_a_second(tmp_path: Path) -> None:
+    stamp = {"approved": True, "approved_by": "Alex Velazquez", "approved_on": "2026-09-22"}
+    root, sentence = _root_with_sentence(tmp_path, **stamp)
+    item = f"sentence {sentence['id']}"
+    digest = audit_log.approve(root, item)
+    log = root / "audit" / "log.jsonl"
+    entry = json.loads(_lines(log)[0])
+    assert (entry["kind"], entry["hash"]) == ("approval", digest)
+    payload = audit_log.approval_payload(item, sentence)
+    assert payload == {
+        "item": item,
+        "text_sha256": hashlib.sha256(approval_text(sentence).encode()).hexdigest(),
+        "approved_by": "Alex Velazquez",
+        "approved_on": "2026-09-22",
+    }
+    assert entry["payload_sha256"] == audit_log.payload_hash(payload)
+    assert audit_log.approval_hashes(log) == {entry["payload_sha256"]}
+    with pytest.raises(audit_log.AuditError, match="already has an approval row"):
+        audit_log.approve(root, item)
+    assert audit_log.verify(log) == 1
+
+
+@pytest.mark.parametrize(
+    ("fields", "refusal"),
+    [
+        ({"approved": False}, "does not say approved: true"),
+        ({"approved": True}, "needs approved_by and approved_on"),
+        ({"approved": True, "approved_by": "Alex Velazquez"}, "needs approved_by and approved_on"),
+    ],
+)
+def test_approve_refuses_what_is_not_approved_with_a_name_and_a_date(
+    tmp_path: Path, capsys: pytest.CaptureFixture[str], fields: dict[str, Any], refusal: str
+) -> None:
+    root, sentence = _root_with_sentence(tmp_path, **fields)
+    args = ["approve", "sentence", sentence["id"], "--root", str(root)]
+    assert audit_log.main(args) == 1
+    assert refusal in capsys.readouterr().err
+    assert not (root / "audit" / "log.jsonl").exists()
