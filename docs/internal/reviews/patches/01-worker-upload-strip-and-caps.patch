+/** One photo up, or null when the API refuses it: too large, not a picture, or the photo store
+ *  full for the day. A photo is optional, so a refused one never stops the check it came with. A
+ *  network failure still throws, so the check waits in the offline queue with its photos. */
+export async function uploadOrSkip(blob: Blob, filename?: string): Promise<string | null> {
+  try {
+    return (await api.upload(blob, filename)).photo_id;
+  } catch (err) {
+    if (err instanceof ApiError) return null;
+    throw err;
+  }
+}
+
 export function isNetworkError(err: unknown): boolean {
   return !(err instanceof ApiError);
 }
