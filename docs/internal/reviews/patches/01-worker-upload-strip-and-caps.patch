+  same([...stripJpeg(trailer)], [...clean], "trailer: nothing after the first end marker");
+
+  // Progressive: an APP1 between two scans.
+  const progressive = bytesOf(SOI, DQT, SOF2, DHT, SOS, SCAN, EXIF, DHT, SOS, SCAN, EOI);
+  const stripped = stripJpeg(progressive);
+  assert.equal(has(stripped, "ProbePhoneMake"), false, "between scans");
+  same([...stripped], [...bytesOf(SOI, DQT, SOF2, DHT, SOS, SCAN, DHT, SOS, SCAN, EOI)], "both scans kept");
+
+  // A byte where a marker should be is refused, never copied as it is.
+  assert.throws(() => stripJpeg(bytesOf(SOI, [0x00], EXIF, DQT, SOF0, SOS, SCAN, EOI)), Invalid, "stray byte");
+});
+
+test("uploads: a file that is not a picture is refused, whatever its first bytes say", () => {
+  const html = bytesOf(SOI, APP0, ascii("<html><script>alert(1)</script></html>"));
+  assert.throws(() => stripJpeg(html), Invalid, "a JPEG prefix and then a web page");
+  assert.throws(() => stripJpeg(bytesOf(SOI, APP0, DQT, SOS, SCAN, EOI)), Invalid, "no frame");
+  assert.throws(() => stripJpeg(bytesOf(SOI, APP0, DQT, SOF0, EOI)), Invalid, "no scan");
+  assert.throws(() => stripJpeg(bytesOf(SOI, APP0, DQT, SOF0, SOS, SCAN)), Invalid, "no end marker");
+  assert.throws(() => stripJpeg(bytesOf(SOI, [0xff, 0xe1, 0x40, 0x00], ascii("Exif"))), Invalid, "a segment longer than the file");
+
+  const chunk = (type: string, data: number[]) => [(data.length >>> 24) & 0xff, (data.length >> 16) & 0xff, (data.length >> 8) & 0xff, data.length & 0xff, ...ascii(type), ...data, 0, 0, 0, 0];
+  const SIG = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a];
+  const IHDR = chunk("IHDR", [0, 0, 0, 1, 0, 0, 0, 1, 8, 2, 0, 0, 0]);
+  const IDAT = chunk("IDAT", [0x78, 0x9c, 0x63, 0x60, 0x00, 0x00, 0x00, 0x04, 0x00, 0x01]);
+  const IEND = chunk("IEND", []);
+  const png = stripPng(bytesOf(SIG, IHDR, chunk("eXIf", ascii(PROBE)), chunk("tEXt", ascii(PROBE)), IDAT, IEND, ascii(PROBE)));
+  same([...png], [...bytesOf(SIG, IHDR, IDAT, IEND)], "png: text, EXIF and anything after IEND go");
+  assert.throws(() => stripPng(bytesOf(SIG, ascii("<html></html>"))), Invalid, "png signature and a web page");
+  assert.throws(() => stripPng(bytesOf(SIG, IHDR, IEND)), Invalid, "png without image data");
+  assert.throws(() => stripPng(bytesOf(SIG, IDAT, IHDR, IEND)), Invalid, "png that does not start with IHDR");
+  assert.throws(() => stripPng(bytesOf(SIG, IHDR, IDAT)), Invalid, "png without IEND");
+
+  const riff = (chunks: number[][], extra: number[] = []) => {
+    const body = [...ascii("WEBP"), ...chunks.flat()];
+    return bytesOf(ascii("RIFF"), [body.length & 0xff, (body.length >> 8) & 0xff, (body.length >> 16) & 0xff, body.length >>> 24], body, extra);
+  };
+  const wchunk = (fourcc: string, data: number[]) => [...ascii(fourcc), data.length & 0xff, (data.length >> 8) & 0xff, 0, 0, ...data, ...(data.length % 2 ? [0] : [])];
+  const VP8L = wchunk("VP8L", [0x2f, 0, 0, 0, 0x10]);
+  same([...stripWebp(riff([VP8L, wchunk("EXIF", ascii(PROBE))], ascii(PROBE)))], [...riff([VP8L])], "webp: EXIF and anything past the RIFF size go");
+  assert.throws(() => stripWebp(riff([wchunk("EXIF", ascii(PROBE))])), Invalid, "webp without a picture chunk");
+  assert.throws(() => stripWebp(riff([VP8L]).slice(0, 20)), Invalid, "webp shorter than its RIFF size");
+});
+
+/** Stand ins for D1 and KV: the room query answers with `room`, every statement and put is kept. */
+function uploadEnv(room: { today: number; held: number }) {
+  const statements: { sql: string; args: unknown[] }[] = [];
+  const puts: { key: string; value: Uint8Array; options: { expirationTtl: number } }[] = [];
+  const DB = {
+    prepare(sql: string) {
+      const statement = {
+        args: [] as unknown[],
+        bind(...args: unknown[]) {
+          statement.args = args;
+          return statement;
+        },
+        async first() {
+          statements.push({ sql, args: statement.args });
+          return sql.startsWith("SELECT COUNT") ? room : null;
+        },
+        async run() {
+          statements.push({ sql, args: statement.args });
+          return { meta: { changes: 0 } };
+        },
+      };
+      return statement;
+    },
+  };
+  const PHOTOS = {
+    async put(key: string, value: Uint8Array, options: { expirationTtl: number }) {
+      puts.push({ key, value, options });
+    },
+  };
+  return { env: { DB, PHOTOS } as never, statements, puts };
+}
+
+function uploadRequest(bytes: Uint8Array) {
+  const form = new FormData();
+  form.append("file", new Blob([bytes], { type: "image/jpeg" }), "photo.jpg");
+  return new Request("http://worker/api/upload", { method: "POST", body: form });
+}
+
+test("uploads: a body over the cap is refused before it is read in full", async () => {
+  const { env, puts } = uploadEnv({ today: 0, held: 0 });
+  const declared = new Request("http://worker/api/upload", { method: "POST", body: "x", headers: { "content-length": String(100 * 1024 * 1024) } });
+  await assert.rejects(storeUpload(env, declared, "2026-09-22T12:00:00Z"), TooLarge, "a declared length over the cap");
+
+  // No length given: 20 chunks of 1 MB. The read stops at the cap instead of taking all 20.
+  let pulled = 0;
+  const stream = new ReadableStream({
+    pull(controller) {
+      pulled += 1;
+      if (pulled > 20) controller.close();
+      else controller.enqueue(new Uint8Array(1024 * 1024));
+    },
+  });
+  const streamed = new Request("http://worker/api/upload", { method: "POST", body: stream, headers: { "content-type": "multipart/form-data; boundary=x" }, duplex: "half" } as RequestInit);
+  await assert.rejects(storeUpload(env, streamed, "2026-09-22T12:00:00Z"), TooLarge, "a body that runs past the cap");
+  assert.ok(pulled <= 10, `read ${pulled} MB before refusing`);
+  assert.equal(puts.length, 0);
+});
+
+test("uploads: the day's cap and the store's cap refuse before anything is written", async () => {
+  const now = "2026-09-22T12:00:00Z";
+  const full = uploadEnv({ today: MAX_UPLOADS_PER_DAY, held: 0 });
+  await assert.rejects(storeUpload(full.env, uploadRequest(plainJpeg()), now), TooMany, "the day's cap");
+  assert.equal(full.puts.length, 0);
+  same(full.statements[0].args, ["2026-09-22T00:00:00Z", "2026-08-23T12:00:00Z"], "today from midnight UTC, held over the last 30 days");
+  const held = uploadEnv({ today: 0, held: MAX_STORED_BYTES - 10 });
+  await assert.rejects(storeUpload(held.env, uploadRequest(plainJpeg()), now), TooMany, "the store's cap");
+  assert.equal(held.puts.length, 0);
+
+  const room = uploadEnv({ today: MAX_UPLOADS_PER_DAY - 1, held: 0 });
+  const made = await storeUpload(room.env, uploadRequest(plainJpeg()), now);
+  assert.match(made.photo_id, /^up-[0-9a-f]{16}$/);
+  assert.equal(room.puts.length, 1);
+  assert.equal(has(room.puts[0].value, "ProbePhoneMake"), false, "what KV holds has no EXIF");
+  assert.equal(room.puts[0].options.expirationTtl, 30 * 24 * 3600);
+  assert.ok(room.statements.some((s) => s.sql.startsWith("INSERT INTO upload") && s.args[4] === now));
+});
+
+test("uploads: rows older than 30 days are deleted by a daily job the Worker runs", async () => {
+  const { env, statements } = uploadEnv({ today: 0, held: 0 });
+  await deleteExpiredUploads((env as { DB: D1Database }).DB, "2026-10-22T12:00:00Z");
+  same(statements, [{ sql: "DELETE FROM upload WHERE created_at < ?", args: ["2026-09-22T12:00:00Z"] }], "the cutoff is 30 days back");
+
+  const config = JSON.parse(readFileSync(join(root, "worker", "wrangler.jsonc"), "utf8").replace(/^\s*\/\/.*$/gm, ""));
+  assert.ok(config.triggers?.crons?.length >= 1, "wrangler.jsonc has a cron trigger");
+  const before = Date.now();
+  statements.length = 0;
+  await worker.scheduled({} as ScheduledController, env);
+  assert.equal(statements.length, 1);
+  assert.equal(statements[0].sql, "DELETE FROM upload WHERE created_at < ?");
+  const cutoff = Date.parse(String(statements[0].args[0]));
+  assert.ok(Math.abs(before - 30 * 24 * 3600 * 1000 - cutoff) < 5000, "the scheduled handler deletes with today's cutoff");
+});
