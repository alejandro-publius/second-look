+/** The secret from an "Authorization: Bearer <secret>" header, never from the URL: the URL, query
+ *  string and all, is what request logs keep. */
+function bearerToken(request: Request): string | null {
+  const m = /^Bearer\s+(\S+)\s*$/i.exec(request.headers.get("authorization") ?? "");
+  return m ? m[1] : null;
