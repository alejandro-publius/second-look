diff --git a/scripts/tests/test_worker_config.py b/scripts/tests/test_worker_config.py
new file mode 100644
index 0000000..bc909de
--- /dev/null
+++ b/scripts/tests/test_worker_config.py
@@ -0,0 +1,38 @@
+"""The deployed API keeps no per-request log (hard rule 7, docs/DATA_HANDLING.md).
+
+With Workers Logs on, Cloudflare stores an invocation log for every request in our account: the
+full URL with its query string, the request headers and Cloudflare's request details, for days.
+worker/wrangler.jsonc turns those logs and traces off. This test fails if either comes back.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Any
+
+WRANGLER = Path(__file__).parents[2] / "worker" / "wrangler.jsonc"
+
+
+def load_jsonc(path: Path) -> dict[str, Any]:
+    """JSON with whole-line // comments, the only kind the Worker's config uses."""
+    text = re.sub(r"^\s*//.*$", "", path.read_text(encoding="utf-8"), flags=re.MULTILINE)
+    data: dict[str, Any] = json.loads(text)
+    return data
+
+
+def test_worker_keeps_no_invocation_logs():
+    observability = load_jsonc(WRANGLER)["observability"]
+    assert observability["logs"]["invocation_logs"] is False
+
+
+def test_worker_keeps_no_traces():
+    observability = load_jsonc(WRANGLER)["observability"]
+    assert observability["traces"]["enabled"] is False
+
+
+def test_load_jsonc_drops_comment_lines_only(tmp_path):
+    path = tmp_path / "w.jsonc"
+    path.write_text('{\n  // a note\n  "url": "https://example.org/x"\n}\n', encoding="utf-8")
+    assert load_jsonc(path) == {"url": "https://example.org/x"}
