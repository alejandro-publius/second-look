@@ -0,0 +1,164 @@
+"""verify_claims reads the number a reader sees, covers docs/*.md, and trusts a study result only
+with its full real stamp (hard rule 12)."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+import pytest
+
+from scripts import render_readme
+from scripts.verify_claims import PLAN_SHA256, check_claims, real_result_problems
+
+ROOT = Path(__file__).resolve().parents[2]
+REAL_STAMP = {
+    "synthetic": False,
+    "generated_at_utc": "2026-09-28T02:00:00Z",
+    "script": "evals/usability_analysis.py",
+    "plan_sha256": PLAN_SHA256,
+}
+
+
+def make_root(tmp_path: Path, readme: str, docs: dict[str, str] | None = None) -> Path:
+    (tmp_path / "results").mkdir(parents=True)
+    (tmp_path / "results" / "v.json").write_text(
+        json.dumps({"errors": 0, "warnings": 52, "mean": 61.25, "passed": True})
+    )
+    (tmp_path / "README.md").write_text(readme)
+    (tmp_path / "docs").mkdir()
+    for name, text in (docs or {}).items():
+        (tmp_path / "docs" / name).write_text(text)
+    return tmp_path
+
+
+def problems_in(root: Path, *, allow_synthetic: bool = False) -> list[str]:
+    _, broken, not_real = check_claims(root, allow_synthetic=allow_synthetic)
+    return broken + not_real
+
+
+def test_the_plan_hash_is_the_hash_of_the_tagged_plan() -> None:
+    plan = (ROOT / "docs" / "analysis_plan.md").read_bytes()
+    assert hashlib.sha256(plan).hexdigest() == PLAN_SHA256
+    notes = (ROOT / "docs" / "notes" / "plan_hash.md").read_text(encoding="utf-8")
+    assert f"`{PLAN_SHA256}`" in notes
+
+
+def test_the_repo_claims_hold_and_the_readme_has_one() -> None:
+    checked, broken, not_real = check_claims(ROOT)
+    assert broken == [] and not_real == []
+    assert checked >= 1
+    assert "<!--v:results/fhir_validation.json#/errors-->" in (ROOT / "README.md").read_text()
+
+
+def test_a_marker_that_matches_what_the_reader_sees_passes(tmp_path: Path) -> None:
+    root = make_root(
+        tmp_path,
+        "<!-- claim: results/v.json#/errors = 0 -->\n\nEvery record has 0 errors.\n"
+        "It has <!-- claim: results/v.json#/warnings = 52 -->52 warnings.\n"
+        "<!-- claim: results/v.json#/mean = 61.25 -->\n"
