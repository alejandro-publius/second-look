+/** Claims this second's one request to their sandbox. One statement both reads and moves the
+ * slot, so two requests that arrive together cannot both win it. */
+async function claimSlot(env: TwoEnv, nowMs: number): Promise<boolean> {
+  const now = new Date(nowMs).toISOString();
+  const free = new Date(nowMs - MIN_INTERVAL_MS).toISOString();
+  const result = await env.DB.prepare(
+    "INSERT INTO sandbox_cache (cache_key, body, status, fetched_at) VALUES (?, '', 'slot', ?) " +
+      "ON CONFLICT (cache_key) DO UPDATE SET fetched_at = excluded.fetched_at WHERE sandbox_cache.fetched_at <= ?",
+  )
+    .bind(SLOT_KEY, now, free)
+    .run();
+  return result.meta.changes === 1;
+}
