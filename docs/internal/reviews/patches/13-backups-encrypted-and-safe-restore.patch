+def test_backup_artifacts_must_be_encrypted_before_the_repo_goes_public(tmp_path: Path) -> None:
+    """A public repo lets anyone download its artifacts, so a plain D1 dump must be gone."""
+    root = build_root(tmp_path)
+    seen: list[list[str]] = []
+
+    def check(artifacts: tuple[int, str]) -> submit_check.Check:
+        runner = fake_runner("PUBLIC", artifacts=artifacts)
+
+        def run(argv: list[str]) -> tuple[int, str]:
+            seen.append(argv)
+            return runner(argv)
+
+        checks = submit_check.run_checks(root, runner=run, fetch=lambda url: 200)
+        return {c.name: c for c in checks}["backup_artifacts"]
+
+    assert check((0, "")).passed
+    assert any("actions/artifacts" in " ".join(a) and "expired" in " ".join(a) for a in seen)
+    encrypted = check((0, "12 d1-backup-age-9001\n"))
+    assert encrypted.passed
+    assert encrypted.notes == ["1 unexpired artifact(s), all encrypted backups"]
+
+    plain = check((0, "12 d1-backup-age-9001\n11 d1-backup-8000\n"))
+    assert not plain.passed
+    assert "d1-backup-8000 (id 11)" in plain.reasons[0]
+    assert "d1-backup-age-9001" not in plain.reasons[0]
+
+    unknown = check((1, "HTTP 403: Resource not accessible"))
+    assert not unknown.passed and "cannot list" in unknown.reasons[0]
