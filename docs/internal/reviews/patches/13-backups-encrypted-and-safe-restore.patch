diff --git a/scripts/tests/test_backups.py b/scripts/tests/test_backups.py
new file mode 100644
index 0000000..06e0fab
--- /dev/null
+++ b/scripts/tests/test_backups.py
@@ -0,0 +1,196 @@
+"""Backups hold every answer and contributor token: encrypted on GitHub, and restores stop safely.
+
+The shell scripts run for real under bash. Wrangler is a fake npx that keeps a list of database
+names in a file, so no test reaches Cloudflare.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import re
+import shutil
+import sqlite3
+import subprocess
+from pathlib import Path
+
+import pytest
+import yaml
+
+REPO = Path(__file__).parents[2]
+BASH = shutil.which("bash")
+pytestmark = pytest.mark.skipif(BASH is None, reason="bash not installed")
+
+# "npx --yes wrangler d1 ..." against $FAKE_D1/dbs, one database name a line. Every call is
+# written to $FAKE_D1/calls. FAKE_DELETE_FAILS makes every delete fail, as an expired login does.
+FAKE_NPX = r"""#!/bin/bash
+shift 2
+echo "$*" >> "$FAKE_D1/calls"
+dbs="$FAKE_D1/dbs"
+case "$1 $2" in
+  "d1 list")
+    printf '['; sep=''
+    while read -r n; do printf '%s\n  { "name": "%s" }' "$sep" "$n"; sep=','; done < "$dbs"
+    printf '\n]\n' ;;
+  "d1 create") echo "$3" >> "$dbs" ;;
+  "d1 delete")
+    [ -z "${FAKE_DELETE_FAILS:-}" ] && grep -qx "$3" "$dbs" || exit 1
+    grep -vx "$3" "$dbs" > "$dbs.new" || true
+    mv "$dbs.new" "$dbs" ;;
+  "d1 execute") case "$*" in *--command*) echo '[{"results":[{"n":3}]}]' ;; esac ;;
+esac
+"""
+
+
+def test_backup_workflow_uploads_only_an_encrypted_dump_made_by_the_locked_wrangler() -> None:
+    flow = yaml.safe_load((REPO / ".github" / "workflows" / "backup.yml").read_text())
+    steps = flow["jobs"]["export"]["steps"]
+    for step in steps:
+        if "uses" in step:
+            assert re.fullmatch(r"[\w-]+/[\w-]+@[0-9a-f]{40}", step["uses"]), step["uses"]
+    runs = [step.get("run", "") for step in steps]
+    assert not any("wrangler@" in r or "npx --yes" in r for r in runs), "no unpinned wrangler"
+    install = next(i for i, r in enumerate(runs) if "npm ci" in r)
+    export = next(i for i, r in enumerate(runs) if "d1 export" in r)
+    assert install < export and steps[install]["working-directory"] == "worker"
+    assert "CLOUDFLARE_API_TOKEN" not in steps[install].get("env", {})
+    assert "./node_modules/.bin/wrangler d1 export" in runs[export]
+    assert "age --encrypt" in runs[export] and 'rm -f "$out"' in runs[export]
+    guard = next(i for i, r in enumerate(runs) if "BACKUP_AGE_RECIPIENT" in r)
+    assert guard < export and "exit 1" in runs[guard]
+    upload = next(s for s in steps if "upload-artifact" in s.get("uses", ""))
+    assert upload["with"]["path"] == "backup/*.age"
+    assert upload["with"]["name"].startswith("d1-backup-age-")
+    assert not flow["env"]["BACKUP_AGE_RECIPIENT"].startswith("AGE-SECRET-KEY")
+
+
+def drill_root(tmp_path: Path, *dbs: str) -> tuple[Path, dict[str, str]]:
+    """A copy of the drill script beside a fake npx, with the given remote databases."""
+    root = tmp_path / "repo"
+    (root / "scripts").mkdir(parents=True)
+    (root / "worker").mkdir()
+    shutil.copy(REPO / "scripts" / "restore_drill_d1.sh", root / "scripts")
+    fake = tmp_path / "fake"
+    (fake / "bin").mkdir(parents=True)
+    npx = fake / "bin" / "npx"
+    npx.write_text(FAKE_NPX)
+    npx.chmod(0o755)
+    (fake / "dbs").write_text("".join(f"{d}\n" for d in dbs))
+    (fake / "calls").write_text("")
+    dump = tmp_path / "second-look-20260922T000000Z.sql"
+    dump.write_text("CREATE TABLE session (id TEXT);\n")
+    env = {
+        "PATH": f"{fake / 'bin'}{os.pathsep}{os.environ['PATH']}",
+        "HOME": str(tmp_path),
+        "FAKE_D1": str(fake),
+        "DUMP": str(dump),
+    }
+    return root, env
+
+
+def run_drill(root: Path, env: dict[str, str], **extra: str) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [str(BASH), str(root / "scripts" / "restore_drill_d1.sh"), env["DUMP"]],
+        env={**env, **extra},
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+
+@pytest.mark.parametrize(
+    ("scratch", "database"),
+    [
+        ("second-look", "second-look"),
+        ("second-look-restore-drill", "second-look-restore-drill"),
+        ("second-look-copy", "second-look"),
+    ],
+)
+def test_drill_refuses_a_scratch_name_that_could_be_the_study_database(
+    tmp_path: Path, scratch: str, database: str
+) -> None:
+    root, env = drill_root(tmp_path, database)
+    proc = run_drill(root, env, D1_SCRATCH=scratch, D1_DATABASE=database)
+    assert proc.returncode == 1 and "stopping" in proc.stderr
+    fake = Path(env["FAKE_D1"])
+    assert (fake / "calls").read_text() == "", "wrangler must not run at all"
+    assert (fake / "dbs").read_text() == f"{database}\n", "the study database is untouched"
+
+
+def test_drill_writes_its_receipt_only_after_the_scratch_copy_is_gone(tmp_path: Path) -> None:
+    root, env = drill_root(tmp_path, "second-look")
+    proc = run_drill(root, env)
+    assert proc.returncode == 0, proc.stderr
+    fake = Path(env["FAKE_D1"])
+    assert (fake / "dbs").read_text() == "second-look\n"
+    calls = (fake / "calls").read_text().splitlines()
+    last_delete = max(i for i, c in enumerate(calls) if c.startswith("d1 delete"))
+    assert calls[last_delete + 1] == "d1 list --json"
+    receipt = json.loads((root / "results" / "backup_drill.json").read_text())
+    assert receipt["restored"] is True and "list showed it gone" in receipt["note"]
+
+
+def test_drill_fails_loudly_when_the_scratch_copy_survives(tmp_path: Path) -> None:
+    """An expired login or a dropped network at the end must not leave a quiet copy behind."""
+    root, env = drill_root(tmp_path, "second-look")
+    proc = run_drill(root, env, FAKE_DELETE_FAILS="1")
+    assert proc.returncode == 1
+    assert "could not confirm that second-look-restore-drill was deleted" in proc.stderr
+    assert "second-look-restore-drill" in (Path(env["FAKE_D1"]) / "dbs").read_text()
+    assert not (root / "results" / "backup_drill.json").exists(), "no receipt claims a delete"
+
+
+def sqlite_db(path: Path, word: str) -> None:
+    with sqlite3.connect(path) as db:
+        db.execute("CREATE TABLE t (word TEXT)")
+        db.execute("INSERT INTO t VALUES (?)", (word,))
+    db.close()
+
+
+def words(path: Path) -> list[str]:
+    db = sqlite3.connect(path)
+    try:
+        return [w for (w,) in db.execute("SELECT word FROM t")]
+    finally:
+        db.close()
+
+
+def run_restore(backup: Path, db: Path, backup_dir: Path) -> subprocess.CompletedProcess[str]:
+    env = {**os.environ, "DATABASE_URL": f"sqlite:///{db}", "BACKUP_DIR": str(backup_dir)}
+    return subprocess.run(
+        [str(BASH), str(REPO / "scripts" / "restore_db.sh"), str(backup)],
+        env=env,
+        capture_output=True,
+        text=True,
+        timeout=60,
+    )
+
+
+def test_restore_db_stops_when_the_safety_copy_fails(tmp_path: Path) -> None:
+    current, old = tmp_path / "cur.db", tmp_path / "old.sqlite"
+    sqlite_db(current, "current")
+    sqlite_db(old, "old file")
+    blocker = tmp_path / "blocker"
+    blocker.write_text("a file where the backup folder should go")
+    proc = run_restore(old, current, blocker / "backups")
+    assert proc.returncode == 1
+    assert "the safety copy failed, so nothing was restored" in proc.stderr
+    assert words(current) == ["current"]
+
+
+def test_restore_db_still_restores_with_a_safety_copy_or_nothing_to_copy(tmp_path: Path) -> None:
+    current, old = tmp_path / "cur.db", tmp_path / "old.sqlite"
+    sqlite_db(current, "current")
+    sqlite_db(old, "old file")
+    backups = tmp_path / "backups"
+    proc = run_restore(old, current, backups)
+    assert proc.returncode == 0, proc.stderr
+    assert words(current) == ["old file"]
+    (safety,) = backups.glob("sl-*-before-restore-*.sqlite")
+    assert words(safety) == ["current"]
+
+    fresh = tmp_path / "fresh.db"
+    proc = run_restore(old, fresh, tmp_path / "fresh-backups")
+    assert proc.returncode == 0, proc.stderr
+    assert "no current database to copy" in proc.stdout
+    assert words(fresh) == ["old file"]
