new file mode 100644
index 0000000..4473061
--- /dev/null
+++ b/apps/web/components/SharedDevice.tsx
@@ -0,0 +1,68 @@
+"use client";
+
+import { useState, useSyncExternalStore } from "react";
+import { clearQueue } from "@/lib/offline";
+import { clearContributorToken, forgetThisDevice, getContributorToken } from "@/lib/session";
+import { t } from "@/lib/t";
+
+const noSubscribe = () => () => undefined;
+
+/**
+ * "Start fresh" for a phone or tablet that more than one person uses. One browser counts as one
+ * person to the study, so this forgets everything this browser keeps: the open sitting, the
+ * random browser token, the contributor token, saved spots and checks that wait to be sent.
+ */
+export function StartFresh({ onDone }: { onDone?: () => void }) {
+  const [done, setDone] = useState(false);
+
+  async function run() {
+    forgetThisDevice();
+    await clearQueue().catch(() => undefined);
+    setDone(true);
+    onDone?.();
+  }
+
+  return (
+    <div className="stack">
+      <p className="small muted">{t("fresh.note")}</p>
+      <div className="btn-row">
+        <button type="button" className="btn btn-secondary" onClick={() => void run()}>
+          {t("fresh.button")}
+        </button>
+      </div>
+      {done ? (
+        <p className="notice notice-ok" role="status">
+          {t("fresh.done")}
+        </p>
+      ) : null}
+    </div>
+  );
+}
+
+/**
+ * Says whose score a creek check will carry before it is sent, by the first four characters of
+ * the kept token, with "Not me" to forget the token on this browser. Read after the first paint,
+ * because the static page has no storage to read.
+ */
+export function ScoreTokenNote() {
+  const stored = useSyncExternalStore(noSubscribe, getContributorToken, () => null);
+  const [notMe, setNotMe] = useState(false);
+  if (!stored || notMe) return null;
+  return (
+    <section className="card stack" data-testid="token-note">
+      <p>{t("check.token_note", { token: stored.slice(0, 4) })}</p>
+      <div className="btn-row">
+        <button
+          type="button"
+          className="btn btn-secondary"
+          onClick={() => {
+            clearContributorToken();
+            setNotMe(true);
+          }}
+        >
+          {t("check.token_not_me")}
+        </button>
+      </div>
+    </section>
+  );
+}
