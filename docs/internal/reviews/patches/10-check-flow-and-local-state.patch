+ * person's sitting or land on their score, and Start fresh makes them a new person to the study.
+ */
+test("leaving the end screen closes the sitting, so the next visit starts at consent", async ({ page }) => {
+  const calls = await mockApi(page, { lessonFirst: false });
+  await page.goto("/t");
+  await passConsent(page);
+  await pickWarmup(page);
+  await answerAllItems(page, () => "Yes");
+  await page.getByRole("button", { name: "See my score" }).click();
+  await expect(page.getByRole("heading", { name: "Your score" })).toBeVisible();
+  await page.getByRole("button", { name: "No thanks" }).click();
+  await expect(page.getByRole("heading", { name: "Thank you" })).toBeVisible();
+  await expect(page.getByRole("heading", { name: "Shared device?" })).toBeVisible();
+
+  await page.goto("/t");
+
+  await expect(page.getByRole("heading", { name: "Before you start" })).toBeVisible();
+  await expect(page.getByText("8 of 16 right")).toHaveCount(0);
+  expect(calls.filter((c) => c.path === "/api/test/resume")).toHaveLength(0);
