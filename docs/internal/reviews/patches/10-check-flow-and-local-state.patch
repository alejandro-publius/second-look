+/** A check as CheckFlow saves it in the phone's queue while offline. */
+function queuedCheck(name: string, status: "waiting" | "failed") {
+  return {
+    kind: "check",
+    created_at: "2026-09-22T17:00:00.000Z",
+    draft: { spot: { new: { name, latitude: 37.8719, longitude: -122.2585, coarse: false } }, answers: { bank_type: "present" }, first_rating: "good", photo_ids: [] },
+    photos: [],
+    status,
+    ...(status === "failed" ? { error: "POST /api/check/draft failed with 422" } : {}),
+  };
+}
+
+/** Puts rows straight into the queue in IndexedDB, the store lib/offline.ts reads. */
+async function seedQueue(page: import("@playwright/test").Page, rows: object[]) {
+  await page.evaluate(
+    (items) =>
+      new Promise<void>((resolve, reject) => {
+        const req = indexedDB.open("second-look", 1);
+        req.onupgradeneeded = () => req.result.createObjectStore("queue", { keyPath: "id", autoIncrement: true });
+        req.onsuccess = () => {
+          const tx = req.result.transaction("queue", "readwrite");
+          for (const item of items) tx.objectStore("queue").add(item);
+          tx.oncomplete = () => {
+            req.result.close();
+            resolve();
+          };
+          tx.onerror = () => reject(tx.error);
+        };
+      }),
+    rows,
+  );
+}
+
+/** Everything the queue holds on this phone right now. */
+async function readQueue(page: import("@playwright/test").Page) {
+  return page.evaluate(
+    () =>
+      new Promise<Record<string, unknown>[]>((resolve) => {
+        const req = indexedDB.open("second-look", 1);
+        req.onupgradeneeded = () => req.result.createObjectStore("queue", { keyPath: "id", autoIncrement: true });
+        req.onsuccess = () => {
+          const tx = req.result.transaction("queue", "readonly");
+          const all = tx.objectStore("queue").getAll();
+          all.onsuccess = () => {
+            req.result.close();
+            resolve(all.result);
+          };
+        };
+      }),
+  );
+}
