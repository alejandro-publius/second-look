+
+test("a picked up sitting offers Start fresh, and the next person gets a new browser token", async ({ page }) => {
+  const calls = await mockApi(page, { lessonFirst: false });
+  await page.goto("/t");
+  await passConsent(page);
+  await pickWarmup(page);
+  for (let i = 1; i <= 3; i++) {
+    await expect(page.getByText(`Photo ${i} of 16`)).toBeVisible();
+    await answerItem(page, "Yes");
+  }
+
+  await page.goto("/t");
+
+  await expect(page.getByText("Photo 4 of 16")).toBeVisible();
+  await expect(page.getByTestId("resumed-note")).toContainText("This browser already started the test.");
+  await page.getByRole("button", { name: "Start fresh" }).click();
+  await passConsent(page);
+  await pickWarmup(page);
+  await expect(page.getByText("Photo 1 of 16")).toBeVisible();
+  await expect(page.getByTestId("resumed-note")).toHaveCount(0);
+  const made = calls.filter((c) => c.path === "/api/test/session");
+  expect(made).toHaveLength(2);
+  expect(made[1].body.client_token_hash).not.toBe(made[0].body.client_token_hash);
+});
+
+test("a sitting left for more than three hours is not picked up again", async ({ page }) => {
+  const calls = await mockApi(page, { lessonFirst: false });
+  await page.goto("/t");
+  await passConsent(page);
+  await pickWarmup(page);
+  await expect(page.getByText("Photo 1 of 16")).toBeVisible();
+  await answerItem(page, "Yes");
+  await expect(page.getByText("Photo 2 of 16")).toBeVisible();
+  await page.evaluate(() => {
+    const open = JSON.parse(localStorage.getItem("sl_open_session")!);
+    localStorage.setItem("sl_open_session", JSON.stringify({ ...open, saved_at: Date.now() - 4 * 60 * 60 * 1000 }));
+  });
+
+  await page.reload();
+
+  await expect(page.getByRole("heading", { name: "Before you start" })).toBeVisible();
+  expect(calls.filter((c) => c.path === "/api/test/resume")).toHaveLength(0);
+  expect(await page.evaluate(() => localStorage.getItem("sl_open_session"))).toBeNull();
+});
