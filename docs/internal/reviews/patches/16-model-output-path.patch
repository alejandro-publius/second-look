+@pytest.mark.parametrize("code", [0x7F, 0x80, 0x9F])
+def test_note_with_delete_or_a_c1_control_is_dropped(code: int) -> None:
+    flags, reasons = parse([good(note=f"concrete {chr(code)} edge")])
+    assert flags == []
+    assert reasons == ["flag 1: note has line breaks or control characters"]
+
+
+def test_note_with_the_arabic_letter_mark_is_dropped() -> None:
+    """U+061C is a direction control too, like U+202E above."""
+    flags, reasons = parse([good(note="concrete " + chr(0x061C) + "edge")])
+    assert flags == []
+    assert reasons == ["flag 1: note has text direction controls"]
+
+
+@pytest.mark.parametrize("code", [0x00AD, 0x200B, 0x200D, 0xFEFF, 0xD800, 0xE000, 0x0378])
+def test_note_with_a_hidden_or_unassigned_character_is_dropped(code: int) -> None:
+    flags, reasons = parse([good(note=f"concrete {chr(code)}edge")])
+    assert flags == []
+    assert reasons == ["flag 1: note has hidden or unassigned characters"]
+
+
+BIG = 10**400
+
+
+@pytest.mark.parametrize(
+    ("raw", "reason"),
+    [
+        ([good(), good(confidence=BIG)], "flag 2: bad confidence: must be between 0 and 1"),
+        ([good(), good(confidence=-BIG)], "flag 2: bad confidence: must be between 0 and 1"),
+        (
+            json.dumps([good(), good(feature="invasive_plant", confidence=BIG)]),
+            "flag 2: bad confidence: must be between 0 and 1",
+        ),
+        ([good(), good(region=[0, 0, 0, BIG])], "flag 2: bad region: parts must be numbers"),
+        ([good(), good(feature=10**5000)], "flag 2: unknown feature (int too big to show)"),
+    ],
+)
+def test_a_number_too_big_for_a_float_drops_only_its_own_flag(raw: object, reason: str) -> None:
+    flags, reasons = parse(raw)
+    assert [f.feature for f in flags] == ["artificial_bank"]
+    assert reasons == [reason]
+
+
+def test_a_model_id_too_big_to_print_is_named_by_its_type() -> None:
+    model_id: Any = 10**5000
+    flags, reasons = parse([good()], model_id=model_id)
+    assert flags == []
+    assert reasons == ["flag 1: unknown model (int too big to show)"]
