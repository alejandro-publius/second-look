+    pin = {"new": {"name": "Garden fence", "latitude": 37.87191234, "longitude": -122.25851234}}
+    spot_id = _new_spot(client, {"new": {**pin["new"], "coarse": False}})
+    spot = client.get(f"/api/spot/{spot_id}").json()["spot"]
