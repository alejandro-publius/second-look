+        ("Raw sewage here, do not let kids swim", "Raw sewage here"),
+    ],
+)
+def test_a_typed_spot_name_is_never_stored_or_published(client, monkeypatch, typed, tell):
+    """Both names pass the place name check. Stored, they would be public on /spot, /city, in
+    every FHIR narrative and in the sandbox mirror, so the store keeps the creek and a number."""
+    monkeypatch.setattr(core_calls, "rain_status", _unknown)
+    freeze_now(NOW)
+    spot_id = _new_spot(client, {"new": {**NEW_SPOT["new"], "name": typed}})
+    with Session(engine) as db:
+        row = must(db.get(SpotRow, spot_id))
+    assert (row.spot_name, row.creek_name) == ("Strawberry Creek spot 1", "Strawberry Creek")
+    view = client.get(f"/api/spot/{spot_id}").text
+    fhir = client.get(f"/api/spot/{spot_id}/fhir").text
+    for where in (row.spot_name, row.reach_name, row.creek_name, view, fhir):
+        assert tell not in where
+    assert "Channel form at Strawberry Creek spot 1: " in fhir
+
+
