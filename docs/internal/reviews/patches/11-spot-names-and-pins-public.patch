+def public_names(
+    db: Session, new: NewSpot, latitude: float | None, longitude: float | None
+) -> tuple[str, str, str]:
+    """The spot, reach and creek names we store and publish: the region pack's creek plus a
+    number, for example "Strawberry Creek spot 12". Never the typed name.
+
+    The typed names are read here only, to find the creek and to notice a test entry. A person's
+    name, a street address or a claim about the water typed as a name would otherwise be public
+    on /spot, /city, in FHIR and in the sandbox mirror (REVIEW_02 F16, F37). The phone keeps the
+    typed name in its saved spots, so the person still knows the spot by it. A name that reads
+    like a test becomes "... test spot N", so /city still flags it for a person to look at.
+    """
+    typed = Spot(
+        spot_id="new",
+        spot_name=new.name,
+        reach_id="new",
+        reach_name=new.reach_name or new.name,
+        creek_id="new",
+        creek_name=new.creek_name or new.name,
+        latitude=latitude,
+        longitude=longitude,
+        coarse=new.coarse,
+    )
+    placed = place_spot(typed, creeks_from_regions(content.get_content().regions))
+    number = db.exec(select(func.count()).select_from(SpotRow)).one() + 1
+    word = "test spot" if act.looks_like_a_test_name(new.name) else "spot"
+    spot_name = f"{placed.creek.name if placed else UNMAPPED_CREEK} {word} {number}"
+    creek_name = placed.creek.name if placed else spot_name
+    reach_name = placed.reach.name if placed and placed.reach else spot_name
+    return spot_name, reach_name, creek_name
