diff --git a/scripts/tests/test_fhir_build.py b/scripts/tests/test_fhir_build.py
new file mode 100644
index 0000000..6541f72
--- /dev/null
+++ b/scripts/tests/test_fhir_build.py
@@ -0,0 +1,134 @@
+"""fhir_build.sh builds only the pinned guide: the full commit, and its resources' sha256.
+
+No network: the guide is a small git repo made here, and a stand-in for SUSHI turns each FSH
+file into one resource named the way SUSHI names them.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import os
+import re
+import shutil
+import subprocess
+from pathlib import Path
+
+import pytest
+
+ROOT = Path(__file__).resolve().parents[2]
+OURS = re.compile(r"^[A-Za-z]+-(sl-|second-look)|^ImplementationGuide-")
+
+FAKE_SUSHI = """#!/usr/bin/env bash
+set -euo pipefail
+out=fsh-generated/resources
+mkdir -p "$out"
+for f in input/fsh/*.fsh; do cp "$f" "$out/StructureDefinition-$(basename "$f" .fsh).json"; done
+for f in input/fsh/second-look/*.fsh; do cp "$f" "$out/Bundle-sl-$(basename "$f" .fsh).json"; done
+ls "$out" > "$out/ImplementationGuide-fake.json"
+"""
+
+pytestmark = pytest.mark.skipif(
+    not all(shutil.which(tool) for tool in ("bash", "git", "rsync", "shasum")),
+    reason="needs bash, git, rsync and shasum",
+)
+
+
+def package_sha256(resources: Path) -> str:
+    """The hash fhir_build.sh takes: each guide file's sha256 and name, sorted, hashed again."""
+    names = sorted(p.name for p in resources.iterdir() if not OURS.match(p.name))
+    listing = "".join(
+        f"{hashlib.sha256((resources / n).read_bytes()).hexdigest()}  {n}\n" for n in names
+    )
+    return hashlib.sha256(listing.encode("utf-8")).hexdigest()
+
+
+def git(repo: Path, *args: str) -> str:
+    identity = ["-c", "user.name=test", "-c", "user.email=test@example.org"]
+    cmd = ["git", "-C", str(repo), *identity, "-c", "commit.gpgsign=false", *args]
+    return subprocess.run(cmd, check=True, capture_output=True, text=True).stdout.strip()
+
+
+def commit_guide(root: Path, profile: str) -> str:
+    src = root / "fhir" / "ig-src"
+    (src / "input" / "fsh" / "profiles.fsh").write_text(profile, encoding="utf-8")
+    git(src, "add", "-A")
+    git(src, "commit", "-q", "-m", "guide")
+    return git(src, "rev-parse", "HEAD")
+
+
+def write_lock(root: Path, short: str, full: str, sha: str | None = None) -> None:
+    lines = [f"ig_commit: {short}", f"ig_commit_full: {full}", "sushi_version: 3.20.1"]
+    if sha is not None:
+        lines.append(f"ig_package_sha256: {sha}")
+    (root / "fhir" / "ig.lock").write_text("\n".join(lines) + "\n", encoding="utf-8")
+
+
+def build(root: Path) -> subprocess.CompletedProcess[str]:
+    env = {**os.environ, "PATH": f"{root / 'bin'}{os.pathsep}{os.environ['PATH']}"}
+    script = root / "scripts" / "fhir_build.sh"
+    return subprocess.run(["bash", str(script)], env=env, capture_output=True, text=True)
+
+
+def resources(root: Path) -> Path:
+    return root / "fhir" / "build" / "ig" / "fsh-generated" / "resources"
+
+
+@pytest.fixture
+def root(tmp_path: Path) -> Path:
+    (tmp_path / "scripts").mkdir()
+    shutil.copy(ROOT / "scripts" / "fhir_build.sh", tmp_path / "scripts" / "fhir_build.sh")
+    (tmp_path / "fhir" / "fsh").mkdir(parents=True)
+    (tmp_path / "fhir" / "fsh" / "visit.fsh").write_text("Instance: sl-visit-1\n")
+    (tmp_path / "fhir" / "ig-src" / "input" / "fsh").mkdir(parents=True)
+    git(tmp_path / "fhir" / "ig-src", "init", "-q")
+    (tmp_path / "bin").mkdir()
+    sushi = tmp_path / "bin" / "npx"
+    sushi.write_text(FAKE_SUSHI, encoding="utf-8")
+    sushi.chmod(0o755)
+    return tmp_path
+
+
+def pinned(root: Path) -> tuple[str, str]:
+    """Build once with no hash in the lock, then pin what the guide hashed to."""
+    commit = commit_guide(root, "Profile: WaterOah\n")
+    write_lock(root, commit[:7], commit)
+    first = build(root)
+    sha = package_sha256(resources(root))
+    assert first.returncode == 1
+    assert f"hash to {sha}, fhir/ig.lock pins none" in first.stderr
+    write_lock(root, commit[:7], commit, sha)
+    return commit, sha
+
+
+def test_the_pinned_guide_builds_and_our_own_fsh_does_not_move_the_pin(root: Path) -> None:
+    pinned(root)
+    done = build(root)
+    assert done.returncode == 0, done.stderr
+    assert "guide package sha256 matches fhir/ig.lock" in done.stdout
+    (root / "fhir" / "fsh" / "city.fsh").write_text("Instance: sl-city-1\n")
+    assert build(root).returncode == 0
+
+
+def test_a_different_guide_under_the_pin_fails(root: Path) -> None:
+    _, sha = pinned(root)
+    moved = commit_guide(root, "Profile: WaterOah\n* status 1..1\n")
+    write_lock(root, moved[:7], moved, sha)
+    done = build(root)
+    assert done.returncode == 1
+    assert f"fhir/ig.lock pins {sha}" in done.stderr
+    assert package_sha256(resources(root)) in done.stderr
+
+
+@pytest.mark.parametrize("which", ["short", "other"])
+def test_the_full_commit_must_be_the_40_character_form_of_the_short_one(
+    root: Path, which: str
+) -> None:
+    commit, sha = pinned(root)
+    if which == "short":
+        write_lock(root, commit[:7], commit[:7], sha)
+    else:
+        other = ("1" if commit[0] == "0" else "0") + commit[1:7]
+        write_lock(root, other, commit, sha)
+    done = build(root)
+    assert done.returncode == 1
+    assert "must be the 40 character form" in done.stderr
diff --git a/scripts/tests/test_fhir_validate.py b/scripts/tests/test_fhir_validate.py
new file mode 100644
index 0000000..81aa222
--- /dev/null
+++ b/scripts/tests/test_fhir_validate.py
@@ -0,0 +1,123 @@
+"""fhir-validate never writes zero errors for a run that checked nothing (hard rule 11)."""
+
+from __future__ import annotations
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+from scripts import fhir_validate
+
+FILE_EXT = "http://hl7.org/fhir/StructureDefinition/operationoutcome-file"
+NAMES = ("referral.json", "visit.json")
+
+
+def outcome_for(*names: str, errors: int = 0) -> dict[str, Any]:
+    """The validator's outcome for several files: a Bundle of one OperationOutcome per file."""
+
+    def one(name: str) -> dict[str, Any]:
+        issue = {"severity": "error", "details": {"text": "bad"}, "expression": ["Bundle"]}
+        return {
+            "resourceType": "OperationOutcome",
+            "extension": [{"url": FILE_EXT, "valueString": f"/somewhere/{name}"}],
+            "issue": [issue] * errors or [{"severity": "information"}],
+        }
+
+    return {"resourceType": "Bundle", "entry": [{"resource": one(n)} for n in names]}
+
+
+@pytest.fixture
+def root(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> Path:
+    golden = tmp_path / "fhir" / "golden"
+    golden.mkdir(parents=True)
+    for name in NAMES:
+        (golden / name).write_text("{}", encoding="utf-8")
+    jar = tmp_path / "validator_cli.jar"
+    jar.write_text("", encoding="utf-8")
+    monkeypatch.setattr(fhir_validate, "ROOT", tmp_path)
+    monkeypatch.setattr(fhir_validate, "GOLDEN", golden)
+    monkeypatch.setattr(fhir_validate, "IG_RESOURCES", tmp_path / "no-guide")
+    monkeypatch.setattr(fhir_validate, "INSTANCES", tmp_path / "no-instances")
+    monkeypatch.setattr(fhir_validate, "RESULTS", tmp_path / "results" / "fhir_validation.json")
+    monkeypatch.setattr(fhir_validate, "JAR", jar)
+    monkeypatch.setattr(sys, "argv", ["fhir_validate.py", "--no-build", "--tx", "n/a"])
+    return tmp_path
+
+
+def validator(
+    monkeypatch: pytest.MonkeyPatch,
+    *,
+    returncode: int,
+    outcome: dict[str, Any] | None,
+    stderr: str = "",
+) -> None:
+    """Stand in for java: maybe write an outcome file, then exit with this code."""
+
+    def run(cmd: list[str], **_kw: Any) -> subprocess.CompletedProcess[str]:
+        if outcome is not None:
+            path = Path(cmd[cmd.index("-output") + 1])
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(json.dumps(outcome), encoding="utf-8")
+        return subprocess.CompletedProcess(cmd, returncode, stdout="", stderr=stderr)
+
+    monkeypatch.setattr(fhir_validate.subprocess, "run", run)
+
+
+def test_a_validator_crash_fails_and_writes_no_results(
+    root: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    validator(monkeypatch, returncode=1, outcome=None, stderr="java.lang.OutOfMemoryError")
+    assert fhir_validate.main() == 2
+    assert not fhir_validate.RESULTS.exists()
+    out = capsys.readouterr().out
+    assert "OutOfMemoryError" in out and "did not finish (exit 1)" in out
+
+
+def test_an_outcome_left_by_an_earlier_run_is_not_read_as_this_one(
+    root: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    stale = root / "fhir" / "build" / "validation_outcome.json"
+    stale.parent.mkdir(parents=True)
+    stale.write_text(json.dumps(outcome_for(*NAMES)), encoding="utf-8")
+    validator(monkeypatch, returncode=1, outcome=None)
+    assert fhir_validate.main() == 2
+    assert not stale.exists() and not fhir_validate.RESULTS.exists()
+
+
+def test_an_exit_other_than_0_or_1_fails_even_with_an_outcome(
+    root: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    validator(monkeypatch, returncode=137, outcome=outcome_for(*NAMES))
+    assert fhir_validate.main() == 2
+    assert not fhir_validate.RESULTS.exists()
+
+
+def test_an_outcome_that_skips_a_file_fails_and_names_it(
+    root: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    validator(monkeypatch, returncode=0, outcome=outcome_for("visit.json"))
+    assert fhir_validate.main() == 2
+    assert not fhir_validate.RESULTS.exists()
+    assert "no outcome for referral.json" in capsys.readouterr().out
+
+
+def test_a_clean_run_writes_zero_errors_and_passes(
+    root: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    validator(monkeypatch, returncode=0, outcome=outcome_for(*NAMES))
+    assert fhir_validate.main() == 0
+    results = json.loads(fhir_validate.RESULTS.read_text(encoding="utf-8"))
+    assert results["errors"] == 0 and sorted(results["by_file"]) == list(NAMES)
+
+
+def test_a_run_with_errors_writes_them_and_fails(
+    root: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    validator(monkeypatch, returncode=1, outcome=outcome_for(*NAMES, errors=1))
+    assert fhir_validate.main() == 1
+    results = json.loads(fhir_validate.RESULTS.read_text(encoding="utf-8"))
+    assert results["errors"] == 2 and results["by_file"]["visit.json"]["error"] == 1
