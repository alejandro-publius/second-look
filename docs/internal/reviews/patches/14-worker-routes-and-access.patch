+"""The smoke test only reads. It runs against production too, where a write lands in D1."""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import pytest
+
+from scripts import smoke
+
+COUNTS = {
+    "by_arm": {
+        "untrained": {"randomized": 0, "completed": 0},
+        "trained": {"randomized": 0, "completed": 0},
+    },
+    "by_source": {},
+    "post_lock": 0,
+}
+READS = {
+    "/": httpx.Response(200, text="<title>Second Look</title>"),
+    "/health": httpx.Response(200, json={"status": "ok"}),
+    "/api/content/hash": httpx.Response(200, json={"content_hash": "934a764fc4ed"}),
+    "/api/test/counts": httpx.Response(200, json=COUNTS),
+}
+
+
+def serve(monkeypatch: pytest.MonkeyPatch, reads: dict[str, httpx.Response]) -> None:
+    def get(url: str, **_: Any) -> httpx.Response:
+        return reads[httpx.URL(url).path]
+
+    def write(*args: Any, **_: Any) -> httpx.Response:
+        raise AssertionError(f"smoke tried to write: {args}")
+
+    monkeypatch.setattr(smoke.httpx, "get", get)
+    for method in ("post", "put", "patch", "delete"):
+        monkeypatch.setattr(smoke.httpx, method, write)
+
+
+def test_smoke_passes_on_reads_alone(
+    monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]
+) -> None:
+    serve(monkeypatch, READS)
+    assert smoke.main() == 0
+    assert "content 934a764fc4ed, db read ok" in capsys.readouterr().out
+
+
+def test_smoke_fails_when_the_database_read_fails(monkeypatch: pytest.MonkeyPatch) -> None:
+    serve(monkeypatch, dict(READS, **{"/api/test/counts": httpx.Response(500, text="down")}))
