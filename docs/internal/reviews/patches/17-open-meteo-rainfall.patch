+def _coordinate(value: float) -> str:
+    """A coordinate as sent: 2 decimals, and 0.00 rather than -0.00 just west or south of zero."""
+    rounded = round(value, COORD_DECIMALS)
+    return f"{rounded if rounded else 0.0:.{COORD_DECIMALS}f}"
+
