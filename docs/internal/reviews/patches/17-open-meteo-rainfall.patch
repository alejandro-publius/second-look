+def rainfall_vectors() -> dict[str, Any]:
+    """dry_status with a fetch that hands back a canned payload: the url it asked for, and the
+    status. The payload has Open-Meteo's shape, 120 hours from 00:00 UTC four days back."""
+    now = datetime(2026, 9, 20, 14, 30, tzinfo=UTC)
+    start = datetime(2026, 9, 16, 0, 0, tzinfo=UTC)
+    pin = (37.871912, -122.258512)
+
+    def payload(rain: dict[int, float] | None = None, count: int = 120) -> dict[str, Any]:
+        """Rain keyed by whole hours before the top of the current hour."""
+        by_hour = {now.replace(minute=0) - timedelta(hours=h): mm for h, mm in (rain or {}).items()}
+        times = [start + timedelta(hours=i) for i in range(count)]
+        return {
+            "latitude": 37.875,
+            "longitude": -122.25,
+            "timezone": "GMT",
+            "hourly_units": {"time": "iso8601", "precipitation": "mm"},
+            "hourly": {
+                "time": [t.strftime("%Y-%m-%dT%H:%M") for t in times],
+                "precipitation": [by_hour.get(t, 0.0) for t in times],
+            },
+        }
+
+    def status(
+        name: str,
+        body: Any,
+        *,
+        at: tuple[float, float] = pin,
+        fails: bool = False,
+        dry_mm: float = rainfall.DEFAULT_DRY_MM,
+        window_hours: int = rainfall.DEFAULT_WINDOW_HOURS,
+    ) -> dict[str, Any]:
+        urls: list[str] = []
+
+        def fetch(url: str) -> Any:
+            urls.append(url)
+            if fails:
+                raise OSError("no network")
+            return body
+
+        got = rainfall.dry_status(
+            at[0], at[1], now, dry_mm=dry_mm, window_hours=window_hours, fetch=fetch
+        )
+        inputs = {
+            "latitude": at[0],
+            "longitude": at[1],
+            "now": now.isoformat(),
+            "payload": body,
+            "fetch_fails": fails,
+            "dry_mm": dry_mm,
+            "window_hours": window_hours,
+        }
+        return case(name, inputs, {"url": urls[0] if urls else None, "status": got})
+
+    misaligned = payload()
+    misaligned["hourly"]["precipitation"] = misaligned["hourly"]["precipitation"][:-1]
+    negative = payload({5: -0.2})
+    # Three decimal values that add to 3.635: a plain running sum gives 3.6350000000000002 and
+    # rounds up to 3.64, Python's sum gives 3.635 and rounds to 3.63.
+    fine = [0.36, 0.245, 0.016, 0.19, 0.353, 0.033, 0.11, 0.383, 0.197, 0.044]
+    fine += [0.062, 0.372, 0.345, 0.087, 0.314, 0.019, 0.287, 0.019, 0.199]
+    coordinates = [
+        ("a placed pin leaves at 2 decimals", pin),
+        ("a coarse point is already at 2 decimals", (37.87, -122.26)),
+        ("an exact tie rounds to the even digit, like Python", (37.125, -122.375)),
+        ("just west of Greenwich is 0.00, not -0.00", (51.4779, -0.0015)),
+        ("just south of the equator is 0.00, not -0.00", (-0.004, 36.8)),
+    ]
+    return {
+        "function": "core.rainfall",
+        "build_url": [
+            case(name, {"latitude": lat, "longitude": lon}, rainfall.build_url(lat, lon))
+            for name, (lat, lon) in coordinates
+        ],
+        "dry_status": [
+            status("dry, four dry days, the pin sent at 2 decimals", payload()),
+            status("wet, no dry day", payload({10: 5.0})),
+            status("exactly the threshold is dry", payload({10: 2.5})),
+            status("dry in the window but 0 dry days", payload({5: 0.5})),
+            status("two dry days", payload({60: 0.3})),
+            status("a tie in the millimetres rounds to even", payload({10: 0.125})),
+            status("Python's sum, not a plain running sum", payload(dict(enumerate(fine, 1)))),
+            status(
+                "a shorter window and a lower line", payload({30: 2.0}), dry_mm=1.0, window_hours=24
+            ),
+            status("the window is not covered", payload(count=10)),
+            status("malformed: the lists do not line up", misaligned),
+            status("malformed: a negative value", negative),
+            status("malformed: not an object", [1, 2, 3]),
+            status("the fetch fails", payload(), fails=True),
+            status("a latitude out of range sends nothing", payload(), at=(91.0, -122.26)),
+        ],
+    }
+
+
