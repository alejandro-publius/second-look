+def sitting_seconds(first_received: datetime, completed: datetime) -> float:
+    """The export's test_seconds: from the first answer the server received to completion, in
+    seconds cut down to a tenth.
+
+    Cut down, never rounded: plan item 5 drops tests completed in under 40 seconds, and 39.96
+    seconds rounded to a tenth would read 40.0 and stay in. The Worker's port is in
+    worker/src/core/scoring.ts and the golden vectors hold both to the same answer.
+    """
+    return ((completed - first_received) // timedelta(milliseconds=100)) / 10
