new file mode 100644
index 0000000..bdbf852
--- /dev/null
+++ b/worker/src/core/lock.ts
@@ -0,0 +1,12 @@
+// core/lock.py: the one UTC data lock. The instant is not typed here: scripts/build_worker_content.py
+// writes core.lock.DATA_LOCK_UTC into content.json, and the golden vectors in golden/helpers.json
+// check the second before it, the second itself and the second after.
+
+import CONTENT from "../content.json";
+
+export const DATA_LOCK_UTC: number = Date.parse(CONTENT.rules.data_lock_utc);
+
+/** True if an instant, in milliseconds since the epoch, is strictly before the lock. */
+export function isBeforeLock(ms: number): boolean {
+  return ms < DATA_LOCK_UTC;
+}
