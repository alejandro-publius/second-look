@@ -0,0 +1,8 @@
+// core/scoring.py, the part the export needs: test_seconds, from the first answer the server
+// received to completion, in seconds cut down to a tenth. Cut down, never rounded: plan item 5
+// drops tests completed in under 40 seconds, and 39.96 seconds rounded would read 40.0.
+
+/** Both times are ISO strings as stored; they carry milliseconds, so the tenth is exact. */
+export function sittingSeconds(firstReceived: string, completed: string): number {
+  return Math.floor((Date.parse(completed) - Date.parse(firstReceived)) / 100) / 10;
+}
