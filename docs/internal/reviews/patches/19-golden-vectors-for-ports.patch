+def test_the_ports_outside_src_core_are_held_to_python_where_it_says_no() -> None:
+    """The Worker's own ports (api.json) and the emitter's error paths carry the cases where
+    Python refuses, so a port that stops refusing fails npm test, not a judge's visit."""
+    api = json.loads((ROOT / "worker" / "golden" / "api.json").read_text(encoding="utf-8"))
+    said = {k: {c["name"]: c["expected"] for c in v} for k, v in api.items() if isinstance(v, list)}
+    assert said["build_record"]["a contributor token of 65 characters"] == {"refused": True}
+    assert said["build_record"]["a score of 5 of 4"] == {"refused": True}
+    assert said["spot_ref"]["over 80 as sent, under once the spaces fold"] == {"refused": None}
+    assert "error" in said["validate_answers"]["a slider with a line break after it"]
+    two_features = said["score_sitting"]["a key for two features: the others are 0 of 0"]
+    assert [s["total"] for s in two_features["scores"]] == [2, 2, 0, 0]
+    assert said["city"]["a creek with no record"] == {
+        "error": "We have no record for that creek yet."
+    }
+    # Oldest first, as the Worker's recordsFor asks D1 for them.
+    answered = {v["visit_id"]: v["answered_at"] for v in api["store"]["visits"]}
+    listed = said["city"]["strawberry creek by its slug"]["visit_ids"]
+    assert listed == sorted(listed, key=answered.__getitem__)
+
+    fhir = json.loads((ROOT / "worker" / "golden" / "fhir_emit.json").read_text(encoding="utf-8"))
+    errors = {c["expected"]["error"].split(": ", 1)[1] for c in fhir["no_referral"]}
+    assert errors == {
+        "no stored pipe Observation to refer to",
+        "the spot Location is not in the stored record",
+    }
+    problems = {c["name"]: c["expected"] for c in fhir["broken_bundles"]}
+    assert problems.pop("a whole Bundle, for contrast") == []
+    assert problems.pop("a component and no value") == []
+    assert all(problems.values()), "every broken Bundle has its problem named"
