index 0000000..01c08ab
--- /dev/null
+++ b/apps/web/scripts/manifest.mjs
@@ -0,0 +1,43 @@
+// The photo manifest reader shared by build-content.mjs and check-bundle.mjs.
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+
+// Small CSV reader that respects double quotes.
+export function parseCsv(text) {
+  const rows = [];
+  let row = [];
+  let field = "";
+  let quoted = false;
+  for (let i = 0; i < text.length; i++) {
+    const c = text[i];
+    if (quoted) {
+      if (c === '"') {
+        if (text[i + 1] === '"') {
+          field += '"';
+          i++;
+        } else quoted = false;
+      } else field += c;
+    } else if (c === '"') quoted = true;
+    else if (c === ",") {
+      row.push(field);
+      field = "";
+    } else if (c === "\n" || c === "\r") {
+      if (c === "\r" && text[i + 1] === "\n") i++;
+      row.push(field);
+      field = "";
+      if (row.some((f) => f !== "")) rows.push(row);
+      row = [];
+    } else field += c;
+  }
+  if (field !== "" || row.length) {
+    row.push(field);
+    if (row.some((f) => f !== "")) rows.push(row);
+  }
+  const [header, ...body] = rows;
+  return body.map((r) => Object.fromEntries(header.map((h, i) => [h, r[i] ?? ""])));
+}
+
+/** Every row of photos/manifest.csv under a repo root, as objects keyed by the header. */
+export function readManifest(repoRoot) {
+  return parseCsv(readFileSync(join(repoRoot, "photos", "manifest.csv"), "utf8"));
+}
