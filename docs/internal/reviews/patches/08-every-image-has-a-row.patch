+"""What the browser gets for a photo: never a test photo's name, and never an image without a row.
+
+Runs apps/web/scripts/build-content.mjs and check-bundle.mjs with Node on a copy of the web
+scripts, next to the real content and photos, so nothing is written into the repository.
+"""
+
+from __future__ import annotations
+
+import csv
+import json
+import shutil
+import subprocess
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+REPO = Path(__file__).parents[2]
+WEB = REPO / "apps" / "web"
+NODE = shutil.which("node")
+
+pytestmark = pytest.mark.skipif(
+    NODE is None or not (WEB / "node_modules" / "js-yaml").is_dir(),
+    reason="needs node and apps/web/node_modules (npm ci in apps/web)",
+)
+
+
+def manifest() -> list[dict[str, str]]:
+    with (REPO / "photos" / "manifest.csv").open(newline="", encoding="utf-8") as f:
+        return list(csv.DictReader(f))
+
+
+def node(script: Path, *args: str) -> subprocess.CompletedProcess[str]:
+    assert NODE is not None
+    return subprocess.run(
+        [NODE, str(script), *args], capture_output=True, text=True, check=False, timeout=120
+    )
+
+
+@pytest.fixture(scope="module")
+def web(tmp_path_factory: pytest.TempPathFactory) -> Path:
+    """A web app folder with the real scripts, built against the real content and photos."""
+    root = tmp_path_factory.mktemp("site")
+    (root / "content").symlink_to(REPO / "content")
+    (root / "photos").symlink_to(REPO / "photos")
+    web = root / "apps" / "web"
+    (web / "scripts").mkdir(parents=True)
+    for name in ("build-content.mjs", "check-bundle.mjs", "manifest.mjs"):
+        shutil.copy(WEB / "scripts" / name, web / "scripts" / name)
+    (web / "public").mkdir()
+    shutil.copy(WEB / "public" / "sw.js", web / "public" / "sw.js")
+    (web / "node_modules").symlink_to(WEB / "node_modules")
+    built = node(web / "scripts" / "build-content.mjs")
+    assert built.returncode == 0, built.stdout + built.stderr
+    return web
+
+
+def generated(web: Path) -> dict[str, Any]:
