@@ -0,0 +1,96 @@
+// After the build: every image the site can serve has a manifest row (hard rule 6), and nothing the
+// browser loads names a test photo.
+//
+// Images. A file under public/photos/ must be a byte copy of a photo in photos/manifest.csv, and
+// public/icons/ holds only the two icons build-content.mjs draws. Any other image under public/ or
+// app/ fails, which is what keeps a scaffold favicon out. The built app is held to the same rule.
+// Names. A test photo's manifest id and source page follow the gold key, so neither may appear in
+// generated/content.json, in public/, or in any file of the built app.
+//
+// Runs as `postbuild`, and with --export after the static export, which it reads from out/.
+import { createHash } from "node:crypto";
+import { existsSync, readdirSync, readFileSync, statSync } from "node:fs";
+import { dirname, extname, join, relative, resolve, sep } from "node:path";
+import { fileURLToPath } from "node:url";
+import { readManifest } from "./manifest.mjs";
+
+const here = dirname(fileURLToPath(import.meta.url));
+const webRoot = resolve(here, "..");
+const repoRoot = resolve(webRoot, "..", "..");
+
+const IMAGE_SUFFIXES = new Set([".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif", ".heic", ".heif", ".svg", ".ico"]);
+const TEXT_SUFFIXES = new Set([".html", ".js", ".json", ".rsc", ".txt", ".body", ".webmanifest"]);
+// Drawn by build-content.mjs: a plain ring in our own colours. Our own work, CC BY 4.0.
+const DRAWN_ICONS = new Set(["icons/icon-192.png", "icons/icon-512.png"]);
+const SHOWN_ROLES = new Set(["warmup", "lesson", "practice", "test"]);
+
+function files(dir) {
+  if (!existsSync(dir)) return [];
+  const out = [];
+  for (const name of readdirSync(dir)) {
+    const p = join(dir, name);
+    if (statSync(p).isDirectory()) out.push(...files(p));
+    else out.push(p);
+  }
+  return out;
+}
+
+function sha256(path) {
+  return createHash("sha256").update(readFileSync(path)).digest("hex");
+}
+
+const rel = (p, base) => relative(base, p).split(sep).join("/");
+
+function main() {
+  const rows = readManifest(repoRoot).filter((row) => row.id && row.file && SHOWN_ROLES.has(row.role));
+  const photoHashes = new Set(rows.map((row) => row.sha256));
+  const tests = rows.filter((row) => row.role === "test");
+  const needles = tests.flatMap((row) => [row.id, row.source_url].filter(Boolean));
+  const exported = process.argv.includes("--export");
+  // What the browser can load: the static export, or the client chunks and prerendered pages.
+  const built = exported ? [join(webRoot, "out")] : [join(webRoot, ".next", "static"), join(webRoot, ".next", "server", "app")];
+  const problems = [];
+
+  function checkImage(path, base) {
+    const name = rel(path, base);
+    if (DRAWN_ICONS.has(name)) return;
+    if (name.startsWith("photos/") && photoHashes.has(sha256(path))) return;
+    problems.push(`image with no manifest row: ${rel(path, webRoot)}`);
+  }
+
+  for (const path of files(join(webRoot, "app"))) {
+    if (IMAGE_SUFFIXES.has(extname(path).toLowerCase())) problems.push(`image with no manifest row: ${rel(path, webRoot)}`);
+  }
+  for (const base of [join(webRoot, "public"), ...built]) {
+    for (const path of files(base)) {
+      if (IMAGE_SUFFIXES.has(extname(path).toLowerCase())) checkImage(path, base);
+    }
+  }
+
+  let read = 0;
+  for (const dir of [join(webRoot, "generated"), join(webRoot, "public"), ...built]) {
+    for (const path of files(dir)) {
+      const suffix = extname(path).toLowerCase();
+      const name = rel(path, webRoot);
+      if (IMAGE_SUFFIXES.has(suffix)) {
+        const hit = tests.find((row) => name.includes(row.id));
+        if (hit) problems.push(`a test photo is served under its manifest id: ${name}`);
+        continue;
+      }
+      if (!TEXT_SUFFIXES.has(suffix)) continue;
+      read += 1;
+      const text = readFileSync(path, "utf8");
+      const hit = needles.find((needle) => text.includes(needle));
+      if (hit) problems.push(`${name} names a test photo: ${hit}`);
+    }
+  }
+
+  if (problems.length) {
+    console.log(problems.join("\n"));
+    console.log(`check-bundle: ${problems.length} problem(s)`);
+    process.exit(1);
+  }
+  console.log(`check-bundle: every image has a row, and ${read} file(s) name no test photo`);
+}
+
+main();
