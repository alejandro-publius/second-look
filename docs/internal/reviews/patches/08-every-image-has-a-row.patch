+    root = tmp_path / "repo"
+    (root / "photos").mkdir(parents=True)
+    write_rows(root, [add_photo(root, "ph-pipe-01")])
+    subprocess.run(["git", "init", "-q", str(root)], check=True)
+    return root
+
+
+def put(root: Path, rel: str, data: bytes) -> None:
+    path = root / rel
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+
+
+def test_a_clean_tree_passes(repo: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    assert check_manifest.main(repo) == 0
+    assert "1 image(s), all with matching rows; 0 of our own" in capsys.readouterr().out
+
+
+def test_a_favicon_outside_photos_has_no_row_and_fails(
+    repo: Path, capsys: pytest.CaptureFixture[str]
