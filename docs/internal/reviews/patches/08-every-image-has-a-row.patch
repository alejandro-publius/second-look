+AUTHOR = "Jo Rivers"
+LICENSE = "CC-BY-4.0"
+
+
+def jpeg(comment: str = "") -> bytes:
+    buffer = io.BytesIO()
+    Image.new("RGB", (40, 30), (110, 120, 130)).save(buffer, "JPEG", comment=comment.encode())
+    return buffer.getvalue()
+
+
+def write_rows(root: Path, rows: list[dict[str, str]]) -> None:
+    with (root / "photos" / "manifest.csv").open("w", newline="", encoding="utf-8") as f:
+        writer = csv.DictWriter(f, fieldnames=MANIFEST_COLUMNS)
+        writer.writeheader()
+        for row in rows:
+            writer.writerow({c: row.get(c, "") for c in MANIFEST_COLUMNS})
+
+
+def add_photo(root: Path, photo_id: str, role: str = "test", alt: str = "") -> dict[str, str]:
+    data = jpeg(photo_id)
+    path = root / "photos" / role / f"{photo_id}.jpg"
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_bytes(data)
+    return {
+        "id": photo_id,
+        "file": f"{role}/{photo_id}.jpg",
+        "sha256": check_manifest.sha256_of(path),
+        "author": AUTHOR,
+        "license": LICENSE,
+        "scene_id": photo_id,
+        "role": role,
+        "feature": "pipe_running",
+        "gold_label": "present",
+        "synthetic": "false",
+        "faces": "false",
+        "alt": alt or f"Calm water under trees on a grey day, view {photo_id.split('-')[-1]}.",
+    }
+
+
+@pytest.fixture()
+def repo(tmp_path: Path) -> Path:
