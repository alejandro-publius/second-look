+def test_an_empty_or_missing_log_fails(tmp_path: Path, capsys: pytest.CaptureFixture[str]) -> None:
+    """An emptied log is a chain of nothing; it must not pass as intact."""
+    path = tmp_path / "audit" / "log.jsonl"
+    assert verify_audit.main(["--path", str(path)]) == 1
+    assert "no log at" in capsys.readouterr().out
+    path.parent.mkdir(parents=True)
+    path.write_text("", encoding="utf-8")
+    assert verify_audit.main(["--path", str(path)]) == 1
+    assert "has no entries" in capsys.readouterr().out
+    assert verify_audit.main(["--path", str(path), "--allow-missing"]) == 0
+    assert "0 entries, chain intact" in capsys.readouterr().out
+
+
+def test_check_returns_the_lines_submit_check_reads(tmp_path: Path) -> None:
+    path = tmp_path / "audit" / "log.jsonl"
+    for i in range(2):
+        audit_log.append("test_only", {"i": i}, path=path, allow_test_kind=True)
+    last = audit_log.last_hash(path)
+    assert verify_audit.check(path, expect_last=last, allow_test_kind=True) == (
+        0,
+        [f"audit-log: 2 entries, chain intact, last hash {last}"],
+    )
+    code, lines = verify_audit.check(path, expect_last="0" * 64, allow_test_kind=True)
