+def same_line(old: str, new: str) -> bool:
+    """True when two lines differ only where one machine cannot know better than another.
+
+    The date changes every day. A license reads "not installed here" for a package this machine
+    did not install (greenlet on an arm64 Mac, pywin32 anywhere but Windows), and the count of
+    unknown licenses in the last line moves with it. Nothing else may differ.
+    """
+    if DATE_RE.sub("", old) == DATE_RE.sub("", new):
+        return True
+    if old.startswith(FOOTER) and new.startswith(FOOTER):
+        return True
+    if not (old.startswith("| ") and new.startswith("| ")):
+        return False
+    a, b = ([c.strip() for c in line.strip().strip("|").split("|")] for line in (old, new))
+    if len(a) != len(b) or len(a) < 3:
+        return False
+    return a[:2] == b[:2] and a[3:] == b[3:] and NOT_INSTALLED in {a[2], b[2]}
+
