diff --git a/scripts/tests/test_check_words.py b/scripts/tests/test_check_words.py
new file mode 100644
index 0000000..343b096
--- /dev/null
+++ b/scripts/tests/test_check_words.py
@@ -0,0 +1,84 @@
+"""The words check fails on a hype word or a blockchain claim, and passes on the repo as it is."""
+
+from __future__ import annotations
+
+import subprocess
+from pathlib import Path
+
+import pytest
+
+from scripts import check_words
+
+REPO = Path(__file__).parents[2]
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "A seamless way to check a creek.",
+        "Robust scores for every volunteer.",
+        "We leverage open photos.",
+        "Cutting-edge vision models.",
+        "This will empower volunteers.",
+        "Unlock the lesson.",
+        "A first of its kind test.",
+        "Real numbers, not guesses.",
+        "Real\nnumbers, wrapped across a line.",
+    ],
+)
+def test_each_hype_word_fails(text: str) -> None:
+    hits = check_words.check_text("README.md", text)
+    assert len(hits) == 1 and "hype word" in hits[0] and hits[0].startswith("README.md:1:")
+
+
+def test_a_named_word_and_a_quote_line_pass() -> None:
+    rule = (
+        'Never the words "seamless", "robust", "cutting-edge",\n"first-of-its-kind", "real number".'
+    )
+    assert check_words.check_text("docs/CONTRACTS.md", rule) == []
+    quoted = "> Constraint failed: dom-6: 'narrative for robust management'\n"
+    assert check_words.check_text("docs/notes/run.md", quoted) == []
+    assert check_words.check_text("apps/web/app/page.tsx", quoted) != []
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "a hash-chained audit log, not a blockchain.",
+        "It is an audit log, not\na blockchain.",
+        "Call it an audit log, never a blockchain.",
+        'Say "audit log" if it comes up. Never "blockchain".',
+    ],
+)
+def test_blockchain_passes_only_as_a_denial(text: str) -> None:
+    assert check_words.check_text("docs/DATA_HANDLING.md", text) == []
+
+
+@pytest.mark.parametrize(
+    "text",
+    ["Every answer is stored on a blockchain.", "Our blockchain-backed log.", "not blockchain"],
+)
+def test_blockchain_as_a_claim_fails(text: str) -> None:
+    hits = check_words.check_text("README.md", text)
+    assert len(hits) == 1 and "rule 20" in hits[0]
+
+
+def test_hit_names_the_line() -> None:
+    hits = check_words.check_text("content/x.yaml", "one\ntwo\nthree: seamlessly\n")
+    assert hits == ["content/x.yaml:3: hype word 'seamlessly' (rule 18)"]
+
+
+def test_scope_skips_internal_docs_and_scripts(tmp_path: Path) -> None:
+    root = tmp_path / "repo"
+    for rel in ("docs/internal/review.md", "scripts/x.py", "docs/public.md", "README.md"):
+        (root / rel).parent.mkdir(parents=True, exist_ok=True)
+        (root / rel).write_text("a robust log\n", encoding="utf-8")
+    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
+    subprocess.run(["git", "add", "-A"], cwd=root, check=True)
+    assert sorted(check_words.tracked_files(root)) == ["README.md", "docs/public.md"]
+    assert check_words.main(["--root", str(root)]) == 1
+
+
+def test_repo_is_clean(capsys: pytest.CaptureFixture[str]) -> None:
+    assert check_words.main(["--root", str(REPO)]) == 0
+    assert "words-check: no hype word" in capsys.readouterr().out
