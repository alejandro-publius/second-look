index 0000000..f49afe1
--- /dev/null
+++ b/scripts/check_words.py
@@ -0,0 +1,98 @@
+"""Fail on a hype word, or on calling the audit log a blockchain (hard rules 18 and 20).
+
+The words are the eight in docs/CONTRACTS.md rule 9. "blockchain" passes only as a denial: "not a
+blockchain", "never a blockchain", never "blockchain". What is read: the tracked text a person or
+a judge reads, which is README.md, docs/ outside docs/internal/, content/, apps/web/app/ and
+apps/web/components/. Two things are not a use of a word: the word alone inside quotes, which
+names it (rule 9 itself does that), and a Markdown quote line starting with ">", which is
+someone else's words.
+
+Run: uv run python scripts/check_words.py
+"""
+
+from __future__ import annotations
+
+import argparse
+import re
+import subprocess
+import sys
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+SCOPE = ("README.md", "docs", "content", "apps/web/app", "apps/web/components")
+SKIP = ("docs/internal/",)
+BINARY_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".woff", ".woff2"}
+HYPE = re.compile(
+    r"\b(?:seamless\w*|robust\w*|leverag\w*|cutting[\s-]+edge|empower\w*|unlock\w*"
+    r"|first[\s-]+of[\s-]+its[\s-]+kind|real\s+numbers?)\b",
+    re.IGNORECASE,
+)
+BLOCKCHAIN = re.compile(r"\bblockchain\w*", re.IGNORECASE)
+DENIAL = re.compile(r"\b(?:not\s+a|never(?:\s+a)?)$", re.IGNORECASE)
+QUOTES = "\"'`“”‘’"
+
+
+def tracked_files(root: Path) -> list[str]:
+    out = subprocess.run(
+        ["git", "ls-files", "-z", "--", *SCOPE], cwd=root, check=True, capture_output=True
+    ).stdout
+    return [p for p in out.decode().split("\0") if p and not p.startswith(SKIP)]
+
+
+def _line_of(text: str, pos: int) -> tuple[int, str]:
+    start = text.rfind("\n", 0, pos) + 1
+    end = text.find("\n", pos)
+    return text.count("\n", 0, pos) + 1, text[start : end if end >= 0 else len(text)]
+
+
+def _named(text: str, m: re.Match[str]) -> bool:
+    """The word alone inside quotes: a mention of the word, not a use of it."""
+    before = text[m.start() - 1] if m.start() > 0 else ""
+    after = text[m.end()] if m.end() < len(text) else ""
+    return bool(before) and bool(after) and before in QUOTES and after in QUOTES
+
+
+def check_text(rel: str, text: str) -> list[str]:
+    """Every hit in one file as "path:line: why". Phrases may wrap across a line break."""
+    hits: list[str] = []
+    for m in HYPE.finditer(text):
+        n, line = _line_of(text, m.start())
+        if _named(text, m) or (rel.endswith(".md") and line.lstrip().startswith(">")):
+            continue
+        word = " ".join(m.group(0).split())
+        hits.append(f"{rel}:{n}: hype word '{word}' (rule 18)")
+    for m in BLOCKCHAIN.finditer(text):
+        before = " ".join(text[max(0, m.start() - 40) : m.start()].split()).rstrip(QUOTES + " ")
+        if DENIAL.search(before):
+            continue
+        n, _ = _line_of(text, m.start())
+        hits.append(f"{rel}:{n}: '{m.group(0)}' outside a denial; it is an audit log (rule 20)")
+    return hits
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument("--root", type=Path, default=ROOT, help=argparse.SUPPRESS)
+    args = parser.parse_args(argv)
+    root = args.root.resolve()
+    hits: list[str] = []
+    files = tracked_files(root)
+    for rel in files:
+        path = root / rel
+        if path.suffix.lower() in BINARY_SUFFIXES or not path.is_file():
+            continue
+        try:
+            text = path.read_text(encoding="utf-8")
+        except (UnicodeDecodeError, OSError):
+            continue
+        hits += check_text(rel, text)
+    if hits:
+        print("\n".join(hits))
+        print(f"words-check: {len(hits)} hit(s)")
+        return 1
+    print(f"words-check: no hype word and no blockchain claim in {len(files)} tracked files")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
