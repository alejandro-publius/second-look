+def stale_lines(committed: str, fresh: str) -> list[str]:
+    """The lines where the committed file and a fresh build differ, marked - and +."""
+    old, new = committed.splitlines(), fresh.splitlines()
+    out: list[str] = []
+    matcher = difflib.SequenceMatcher(None, old, new, autojunk=False)
+    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
+        if tag == "equal":
+            continue
+        if i2 - i1 == j2 - j1 and all(map(same_line, old[i1:i2], new[j1:j2])):
+            continue
+        out += [f"- {line}" for line in old[i1:i2]] + [f"+ {line}" for line in new[j1:j2]]
+    return out
+
